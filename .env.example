# Netlify-native architecture
# The React app calls same-origin /api/game and /api/auth functions.
# Netlify Blobs provides persistent storage automatically for the site.

# Google Identity Services - OAuth 2.0 Web Client ID.
# Also expose the same value to Vite so the Google button can render.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Apple Sign In - Services ID used by your website.
APPLE_CLIENT_ID=com.example.thulla.web
VITE_APPLE_CLIENT_ID=com.example.thulla.web
# Must exactly match the Return URL registered in Apple Developer.
VITE_APPLE_REDIRECT_URI=https://thulla-bhabhi.netlify.app/
