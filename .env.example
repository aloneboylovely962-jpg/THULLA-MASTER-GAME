# Frontend WebSocket endpoint. Example: wss://your-railway-service.up.railway.app
VITE_SERVER_URL=wss://YOUR-RAILWAY-DOMAIN

# Server settings
# PORT is supplied automatically by Railway.
MAX_CONNECTIONS=500
# Comma-separated browser origins, e.g. https://thulla-master-game.vercel.app
ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN

# Phase 5 account database (Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false only when your PostgreSQL provider does not use TLS.
DATABASE_SSL=true
