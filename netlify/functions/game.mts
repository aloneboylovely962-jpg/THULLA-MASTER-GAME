export default async(req:Request)=>{try{if(req.method==='OPTIONS')return new Response(null,{status:204});const body=req.method==='POST'?await req.json():{};const action=String(body.action||'');const rl=await rateLimit(`${clientKey(req)}:${action||'state'}`,false);if(!rl.allowed)return json({error:'Too many requests. Please slow down.'},429,{'retry-after':String(rl.retryAfter)});const u=await user(req);if(!u)return json({error:'Sign in required.'},401);if(action==='profile')return json({profile:profile(u)});if(action==='leaderboard'){const {blobs}=await store.list({prefix:'user:'});const all:User[]=[];for(const b of blobs.slice(0,500)){const x=await read<User>(b.key);if(x?.games_played)all.push(x);}all.sort((a,b)=>b.wins-a.wins||b.xp-a.xp||a.games_played-b.games_played);return json({players:all.slice(0,100).map((x,i)=>({...profile(x),rank:i+1}))});}if(action==='matches'){const {blobs}=await store.list({prefix:'match:'});const rows=[];for(const b of blobs){if(!b.key.endsWith(`:${u.id}`))continue;const x=await read<any>(b.key);if(x)rows.push(x);}rows.sort((a,b)=>String(b.playedAt).localeCompare(String(a.playedAt)));return json({matches:rows.slice(0,50)});}if(action==='create_room'){let code='';do code=String(randomInt(100000,1000000));while(await read(`room:${code}`));const p:Player={id:randomUUID(),userId:u.id,name:u.display_name,ready:false,hand:[],lastSeen:Date.now()};const r:Room={code,hostId:p.id,phase:'lobby',currentPlayerId:null,leadSuit:null,trick:[],winnerPlayerId:null,loserPlayerId:null,players:[p],rewarded:false,matchId:null,updatedAt:Date.now()};await write(`room:${code}`,r);return json({state:publicRoom(r,p.id)});}const code=String(body.code||'').trim();const r=await read<Room>(`room:${code}`);if(!r)return json({error:'Room not found.'},404);let p=r.players.find(x=>x.userId===u.id);if(action==='join_room'&&!p){if(r.phase!=='lobby')return json({error:'Game already started.'},409);if(r.players.length>=5)return json({error:'Room is full.'},409);p={id:randomUU