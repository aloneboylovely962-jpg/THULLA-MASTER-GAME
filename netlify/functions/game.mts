import { createDeck as createCanonicalDeck, shuffle as shuffleCanonical, cardCanBePlayed } from '../../src/game/engine';
import type { Card as EngineCard, Suit } from '../../src/game/engine';
const store=getStore({name:'thulla-game',consistency:'strong'});type Card=EngineCard;type Player={id:string;userId:string|null;name:string;ready:boolean;hand:Card[];lastSeen:number};type Room={code:string;hostId:string;phase:'lobby'|'playing'|'finished';currentPlayerId:string|null;leadSuit:Suit|null;trick:{playerId:string;card:Card}[];winnerPlayerId:string|null;loserPlayerId:string|null;players:Player[];rewarded:boolean;matchId:string|null;updatedAt:number};type User={id:string;username:string;display_name:string;password_hash:string;coins:number;xp:number;level:number;wins:number;losses:number;games_played:number;created_at:string};type Session={userId:string;expiresAt:number};const json=(body:unknown,status=200,headers:Record<string,string>={})=>Response.json(body,{status,headers:{'cache-control':'no-store',...headers}});const safeName=(v:unknown)=>String(v||'Player').trim().replace(/[^\p{L}\p{N} _-]/gu,'').slice(0,18)||'Player';const read=async<T>(k:string)=>await store.get(k,{type:'json'}) as T|null;const write=(k:string,v:unknown)=>store.setJSON(k,v);const authToken=(r:Request)=>String(r.headers.get('authorization')||'').replace(/^Bearer\s+/i,'').trim();async function user(r:Request){const t=authToken(r),s=t?await read<Session>(`session:${t}`):null;if(!s||s.expiresAt<Date.now())return null;return await read<User>(`user:${s.userId}`);}const profile=(u:User)=>({id:u.id,username:u.username,display_name:u.display_name,coins:u.coins,xp:u.xp,level:u.level,wins:u.wins,losses:u.losses,games_played:u.games_played});const publicRoom=(r:Room,you:string)=>({code:r.code,hostId:r.hostId,phase:r.phase,currentPlayerId:r.currentPlayerId,leadSuit:r.leadSuit,trick:r.trick,winnerPlayerId:r.winnerPlayerId,loserPlayerId:r.loserPlayerId,matchId:r.matchId,players:r.players.map(p=>({id:p.id,name:p.name,ready:p.ready,connected:Date.now()-p.lastSeen<15000,cardCount:p.hand.length})),you,hand:r.players.find(p=>p.id===you)?.hand||[]});async function reward(r:Room){if(r.rewarded)return;r.rewarded=true;r.matchId=randomUUID();for(let i=0;i<r.players.length;i++){const p=r.players[i];if(!p.userId)continue;const u=await read<User>(`user:${p.userId}`);if(!u)continue;const loser=p.id===r.loserPlayerId;u.coins+=loser?20:50;u.xp+=loser?40:100;u.level=1+Math.floor(u.xp/1000);u.wins+=loser?0:1;u.losses+=loser?1:0;u.games_played++;await write(`user:${u.id}`,u);await write(`match:${r.matchId}:${u.id}`,{matchId:r.matchId,roomCode:r.code,playedAt:new Date().toISOString(),finishPosition:loser?r.players.length:i+1,coinsDelta:loser?20:50,xpDelta:loser?40:100,winnerUsername:r.players.find(x=>x.id!==r.loserPlayerId)?.name||null});}await write(`room:${r.code}`,r);}
export default async(req:Request)=>{try{if(req.method==='OPTIONS')return new Response(null,{status:204});const body=req.method==='POST'?await req.json():{};const action=String(body.action||'');const rl=await rateLimit(`${clientKey(req)}:${action||'state'}`,false);if(!rl.allowed)return json({error:'Too many requests. Please slow down.'},429,{'retry-after':String(rl.retryAfter)});const u=await user(req);if(!u)return json({error:'Sign in required.'},401);if(action==='profile')return json({profile:profile(u)});if(action==='leaderboard'){const {blobs}=await store.list({prefix:'user:'});const all:User[]=[];for(const b of blobs.slice(0,500)){const x=await read<User>(b.key);if(x?.games_played)all.push(x);}all.sort((a,b)=>b.wins-a.wins||b.xp-a.xp||a.games_played-b.games_played);return json({players:all.slice(0,100).map((x,i)=>({...profile(x),rank:i+1}))});}if(action==='matches'){const {blobs}=await store.list({prefix:'match:'});const rows=[];for(const b of blobs){if(!b.key.endsWith(`:${u.id}`))continue;const x=await read<any>(b.key);if(x)rows.push(x);}rows.sort((a,b)=>String(b.playedAt).localeCompare(String(a.playedAt)));return json({matches:rows.slice(0,50)});}if(action==='create_room'){let code='';do code=String(randomInt(100000,1000000));while(await read(`room:${code}`));const p:Player={id:randomUUID(),userId:u.id,name:u.display_name,ready:false,hand:[],lastSeen:Date.now()};const r:Room={code,hostId:p.id,phase:'lobby',currentPlayerId:null,leadSuit:null,trick:[],winnerPlayerId:null,loserPlayerId:null,players:[p],rewarded:false,matchId:null,updatedAt:Date.now()};await write(`room:${code}`,r);return json({state:publicRoom(r,p.id)});}const code=String(body.code||'').trim();const r=await read<Room>(`room:${code}`);if(!r)return json({error:'Room not found.'},404);let p=r.players.find(x=>x.userId===u.id);if(action==='join_room'&&!p){if(r.phase!=='lobby')return json({error:'Game already started.'},409);if(r.players.length>=5)return json({error:'Room is full.'},409);p={id:randomUUID(),userId:u.id,name:safeName(u.display_name),ready:false,hand:[],lastSeen:Date.now()};r.players.push(p);await write(`room:${r.code}`,r);return json({state:publicRoom(r,p.id)});}if(!p)return json({error:'You are not in this room.'},403);p.lastSeen=Date.now();if(action==='state')return json({state:publicRoom(r,p.id)});if(action==='ready'){if(r.phase!=='lobby')return json({error:'Game already started.'},409);p.ready=!p.ready;await write(`room:${r.code}`,r);return json({state:publicRoom(r,p.id)});}if(action==='start_game'){if(r.hostId!==p.id)return json({error:'Only the host can start.'},403);if(r.players.length<3||!r.players.every(x=>x.ready))return json({error:'Need 3-5 players and everyone ready.'},400);const canonical=shuffleCanonical(createCanonicalDeck());const engineGame=createAuthoritativeGame(r.players.map(x=>({id:x.id,name:x.name,hand:[]})),canonical);r.players=r.players.map(x=>({...x,hand:engineGame.players.find(ep=>ep.id===x.id)?.hand||[],ready:false}));r.phase='playing';r.currentPlayerId=engineGame.currentPlayerId;r.leadSuit=engineGame.leadSuit;r.trick=[];r.winnerPlayerId=null;r.loserPlayerId=null;r.rewarded=false;r.matchId=null;r.updatedAt=Date.now();await write(`room:${r.code}`,r);return json({state:publicRoom(r,p.id)});}if(action==='play_card'){if(r.phase!=='playing')return json({error:'Game is not active.'},409);if(r.currentPlayerId!==p.id)return json({error:'It is not your turn.'},409);const card=p.hand.find(c=>c.id===String(body.cardId));if(!card)return json({error:'Card is not in your hand.'},400);if(!cardCanBePlayed(card,p.hand,r.leadSuit))return json({error:`You must follow ${r.leadSuit}.`},400);const engineState=hydrateAuthoritativeGame({players:r.players.map(x=>({id:x.id,name:x.name,hand:x.hand})),currentPlayerId:r.currentPlayerId,trick:r.trick,leadSuit:r.leadSuit});const next=applyAuthoritativeCard(engineState,p.id,card.id);r.players=r.players.map(x=>({...x,hand:next.players.find(np=>np.id===x.id)?.hand||x.hand}));r.currentPlayerId=next.currentPlayerId;r.leadSuit=next.leadSuit;r.winnerPlayerId=next.winnerPlayerId;r.trick=next.trick;r.updatedAt=Date.now();if(next.phase==='finished'){r.phase='finished';r.loserPlayerId=next.loserPlayerId;}await write(`room:${r.code}`,r);if(r.phase==='finished')await reward(r);return json({state:publicRoom(r,p.id)});}if(action==='leave'){r.players=r.players.filter(x=>x.id!==p.id);if(!r.players.length){await store.delete(`room:${r.code}`);return json({left:true});}if(r.hostId===p.id)r.hostId=r.players[0].id;await write(`room:${r.code}`,r);return json({left:true});}return json({error:'Unknown action.'},400);}catch(e){console.error('thulla-game-error',e);return json({error:'Server error.'},500);}};
